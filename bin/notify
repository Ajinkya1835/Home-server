#!/bin/bash
# notify TITLE MESSAGE [priority] -> ~/alerts.log (shown in Dozzle) + GitHub issue for high priority
T="${1:-alert}"; M="${2:-}"; P="${3:-default}"
H=${NOTIFY_HOME:-$HOME}
GH_TOKEN=""; GH_REPO=""
[ -f "$H/.deploy.env" ] && . "$H/.deploy.env"
echo "$(date '+%F %T') [$P] $T - $M" >> "$H/alerts.log"
case "$P" in high|urgent) ;; *) exit 0 ;; esac
[ -n "$GH_TOKEN" ] && [ -n "$GH_REPO" ] || exit 0
S="$H/.notify-state"; mkdir -p "$S"
K="$S/$(printf '%s' "$T" | md5sum | cut -c1-12)"
[ -n "$(find "$K" -mmin -360 2>/dev/null)" ] && exit 0
touch "$K"
python3 - "$T" "$M" <<'PY' | curl -fsS -m 15 -X POST -H "Authorization: Bearer $GH_TOKEN" -H "Accept: application/vnd.github+json" -d @- "https://api.github.com/repos/$GH_REPO/issues" >/dev/null 2>&1
import json, sys
print(json.dumps({"title": "[server] " + sys.argv[1], "body": sys.argv[2] + "\n\nSee ~/alerts.log and ~/deploy.log on the server."}))
PY
exit 0

#!/usr/bin/env python3
"""Regenerate the "Deployments" group in the homepage config from the edge site directory.

Every directory under /home/ajinkya/docker/edge/site that contains an index.html becomes a
card on the dashboard, so deploying a new static site is just copying a folder in.
Optional metadata: <site>/meta.json  {"name": "...", "desc": "..."}
"""
import json, os, re, subprocess, sys

SITE_DIR = os.environ.get("EDGE_SITE_DIR", os.path.expanduser("~/docker/edge/site"))
SERVICES = os.environ.get("HOMEPAGE_SERVICES", os.path.expanduser("~/docker/homepage/config/services.yaml"))
PUBLIC_BASE = os.environ.get("PUBLIC_BASE", "https://ajinkya.tail32b205.ts.net")
START = "# >>> deployments (generated by bin/deployments-sync, do not edit by hand)"
END = "# <<< deployments"

ICONS = ["mdi-web", "mdi-application-braces-outline", "mdi-rocket-launch-outline",
         "mdi-monitor-dashboard", "mdi-cellphone-link"]


def title_for(slug, path):
    meta = os.path.join(path, "meta.json")
    if os.path.exists(meta):
        try:
            m = json.load(open(meta))
            if m.get("name"):
                return m["name"], m.get("desc", ""), m.get("icon", "")
        except Exception:
            pass
    idx = os.path.join(path, "index.html")
    name = slug.replace("-", " ").title()
    try:
        html = open(idx, encoding="utf-8", errors="ignore").read(4000)
        t = re.search(r"<title[^>]*>(.*?)</title>", html, re.S | re.I)
        if t:
            name = re.split(r"\s+[—|-]\s+", t.group(1).strip())[0].strip()[:44]
    except Exception:
        pass
    return name, "", ""


def url_for(slug):
    return f"{PUBLIC_BASE}/portfolio/" if slug == "portfolio" else f"{PUBLIC_BASE}/s/{slug}/"


def build_block():
    slugs = []
    if os.path.isdir(SITE_DIR):
        for d in sorted(os.listdir(SITE_DIR)):
            p = os.path.join(SITE_DIR, d)
            if os.path.isdir(p) and os.path.exists(os.path.join(p, "index.html")):
                slugs.append(d)
    lines = [START, "- Deployments:"]
    for i, slug in enumerate(slugs):
        p = os.path.join(SITE_DIR, slug)
        name, desc, icon = title_for(slug, p)
        url = url_for(slug)
        desc = desc or ("self-hosted showcase" if slug == "portfolio" else "static deployment")
        lines += [
            f"  - {json.dumps(name)}:",
            f"      icon: {icon or ICONS[i % len(ICONS)]}",
            f"      href: {url}",
            f"      description: {json.dumps(desc)}",
            f"      siteMonitor: {url}",
        ]
    if not slugs:
        lines += ["  - nginx edge:", "      icon: mdi-server-network",
                  "      description: no sites deployed yet"]
    lines.append(END)
    return "\n".join(lines) + "\n"


def main():
    if not os.path.exists(SERVICES):
        print(f"missing {SERVICES}", file=sys.stderr)
        return 1
    conf = open(SERVICES, encoding="utf-8").read()
    if START not in conf:
        print("markers not found in services.yaml - nothing to do", file=sys.stderr)
        return 1
    head, rest = conf.split(START, 1)
    _, tail = rest.split(END, 1)
    new = head + build_block() + tail.lstrip("\n")
    if new == conf:
        print("deployments unchanged")
        return 0
    open(SERVICES, "w", encoding="utf-8").write(new)
    print("deployments updated ->", ", ".join(re.findall(r"^\s+- \"(.+?)\":", build_block(), re.M)) or "none")
    if os.environ.get("NO_RESTART") != "1":
        subprocess.run(["docker", "compose", "up", "-d", "--force-recreate", "homepage"],
                       cwd=os.path.expanduser("~/docker/homepage"),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print("homepage recreated")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/bin/bash
# ~/bin/server-snapshot - keep SERVER.md current and log every change to CHANGELOG.md
set -uo pipefail
exec 9>/tmp/repo.lock; flock -w 120 9 || exit 0
H=$(date +%H%M); [[ "$H" > "0259" && "$H" < "0311" ]] && exit 0   # skip during nightly backup
R=$HOME/Home-server; D=$R/docs/server; S=$HOME/.server-state
mkdir -p "$D" "$S"
N8N_WEBHOOK=""; HERMES_CMD=""
[ -f "$HOME/.deploy.env" ] && . "$HOME/.deploy.env"

gen() {
  echo "# Server inventory"; echo
  echo "Auto-generated by ~/bin/server-snapshot. Do not edit by hand."; echo
  echo "## System"
  echo "- Host: $(hostname)"
  echo "- OS: $(. /etc/os-release; echo "$PRETTY_NAME")"
  echo "- Kernel: $(uname -r)"
  echo "- CPU: $(lscpu | awk -F: '/Model name/{gsub(/^ +/,"",$2);print $2}') ($(nproc) cores)"
  echo "- RAM: $(free -h | awk '/Mem:/{print $2}'), swap $(free -h | awk '/Swap:/{print $2}')"
  echo "- Installed packages: $(dpkg-query -W | wc -l)"
  echo "- Docker: $(docker --version)"
  echo "- Tailscale: $(tailscale version 2>/dev/null | head -1)"
  echo; echo "## Disks"; echo '```'
  lsblk -e7 -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINT
  echo '```'; echo; echo "## Mounts (fstab)"; echo '```'
  grep -vE '^#|^$' /etc/fstab
  echo '```'; echo; echo "## Containers (name | image | image id)"; echo '```'
  docker inspect --format '{{.Name}} | {{.Config.Image}} | {{.Image}}' $(docker ps -aq) 2>/dev/null | sed 's#^/##; s/sha256:\(............\)[0-9a-f]*/\1/' | sort
  echo '```'; echo; echo "## Container ports"; echo '```'
  docker ps -a --format '{{.Names}} | {{.Ports}}' | sort
  echo '```'; echo; echo "## Compose stacks"; echo '```'
  docker compose ls -a 2>/dev/null
  echo '```'; echo; echo "## Docker volumes"; echo '```'
  docker volume ls --format '{{.Name}}' | sort
  echo '```'; echo; echo "## Listening ports"; echo '```'
  ss -tuln | awk 'NR>1{print $1, $5}' | sort -u
  echo '```'; echo; echo "## Enabled services"; echo '```'
  systemctl list-unit-files --state=enabled --type=service --no-legend | awk '{print $1}'
  echo '```'; echo; echo "## Failed services"; echo '```'
  systemctl --failed --no-legend
  echo '```'; echo; echo "## Cron (user and /etc/cron.d)"; echo '```'
  crontab -l 2>/dev/null | grep -vE '^#|^$'
  cat /etc/cron.d/* 2>/dev/null | grep -vE '^#|^$'
  echo '```'; echo; echo "## Tailscale serve"; echo '```'
  tailscale serve status 2>&1
  echo '```'; echo; echo "## .env variable names (values never stored)"; echo '```'
  for e in "$HOME"/docker/*/.env; do [ -f "$e" ] && { echo "[$e]"; sed -E '/^#/d;/^$/d;s/=.*/=/' "$e"; }; done
  echo '```'; echo; echo "## File fingerprints (scripts and compose files)"; echo '```'
  sha256sum "$HOME"/bin/* "$HOME"/docker/*/compose*.y*ml "$HOME"/docker/*/docker-compose.y*ml 2>/dev/null | awk '{print substr($1,1,12), $2}'
  echo '```'
}

difflines() { diff -U0 "$1" "$2" | grep -vE '^(\+\+\+|---|@@)'; }

NEW=$S/new.md; OLD=$S/old.md
gen > "$NEW" 2>/dev/null
dpkg-query -W | sort > "$S/pkg.new"

TS=$(date '+%F %T'); CH=""
if [ -f "$OLD" ]; then
  CH=$(difflines "$OLD" "$NEW"; [ -f "$S/pkg.old" ] && difflines "$S/pkg.old" "$S/pkg.new" | sed 's/^/pkg /')
else
  CH="Baseline snapshot created"
fi
[ -z "$CH" ] && [ -f "$D/SERVER.md" ] && exit 0

SUMMARY=""
[ -n "$HERMES_CMD" ] && SUMMARY=$(printf '%s\n' "$CH" | timeout 60 $HERMES_CMD 2>/dev/null)

CL=$D/CHANGELOG.md
[ -f "$CL" ] || printf '# Server change log\n\nAuto-generated, newest first.\n\n' > "$CL"
{
  head -4 "$CL"
  echo "## $TS"
  [ -n "$SUMMARY" ] && { echo "Summary: $SUMMARY"; echo; }
  echo '```diff'; echo "$CH"; echo '```'; echo
  tail -n +5 "$CL"
} > "$CL.tmp" && mv "$CL.tmp" "$CL"

{ cat "$NEW"; echo; echo "_Last change recorded: ${TS}_"; } > "$D/SERVER.md"
cp "$NEW" "$OLD"; cp "$S/pkg.new" "$S/pkg.old"

if [ -n "$N8N_WEBHOOK" ]; then
  N=$(printf '%s\n' "$CH" | wc -l)
  printf '%s' "$CH" | python3 -c 'import json,sys;print(json.dumps({"commit":"server-snapshot: '"$N"' changed lines","status":"changed","stacks":"","changes":sys.stdin.read()[:3000]}))' \
    | curl -fsS -m 10 -H 'Content-Type: application/json' -d @- "$N8N_WEBHOOK" >/dev/null 2>&1
fi

cd "$R" || exit 1
git add docs/server && git commit -q -m "docs: server snapshot $TS [skip ci]" -- docs/server
git pull --rebase --autostash -q origin main && git push -q origin main || echo "$TS git push failed"
exit 0

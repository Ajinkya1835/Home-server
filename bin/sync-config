#!/bin/bash
# nightly: refresh repo config from live server, commit + push only if the scan is clean
exec 9>/tmp/repo.lock; flock -w 120 9 || exit 0
OUT=$(~/bin/collect-config 2>&1)
if echo "$OUT" | grep -q 'SECRET-LIKE (not staged'; then
  ~/bin/event "Config sync blocked" "secret-like file found, see ~/sync-config.log" high
  { echo "$(date '+%F %T') BLOCKED"; echo "$OUT"; } >> ~/sync-config.log; exit 1
fi
cd ~/Home-server || exit 1
git add -A bin docker host .gitignore
git diff --cached --quiet && exit 0
git commit -q -m "auto: config sync $(date +%F)" && git pull --rebase --autostash -q origin main && git push -q origin main || echo "$(date '+%F %T') push failed" >> ~/sync-config.log

#!/bin/bash
set -uo pipefail
exec 9>/tmp/deploy.lock; flock -n 9 || exit 0
R=$HOME/Home-server; LOG=$HOME/deploy.log
N8N_WEBHOOK=""; HERMES_CMD=""
[ -f "$HOME/.deploy.env" ] && . "$HOME/.deploy.env"
log(){ echo "$(date '+%F %T') $*" >> "$LOG"; }
cd "$R" || exit 1
git fetch -q origin || { log "fetch failed"; exit 1; }
OLD=$(git rev-parse HEAD); NEW=$(git rev-parse origin/main)
[ "$OLD" = "$NEW" ] && exit 0
[ "$(git merge-base "$OLD" "$NEW")" = "$NEW" ] && exit 0
git merge --ff-only -q origin/main 2>>"$LOG" || { log "merge FAILED"; "$HOME/bin/ntfy-send" "Deploy FAILED" "merge failed" high warning; exit 1; }
SUBJ=$(git log -1 --format='%h %s')
ok=1; done_list=""
for s in $(git diff --name-only "$OLD" "$NEW" | awk -F/ '$1=="docker"{print $2}' | sort -u); do
  [ -d "$HOME/docker/$s" ] || continue
  cp docker/$s/compose*.y*ml docker/$s/docker-compose.y*ml "$HOME/docker/$s/" 2>/dev/null
  if (cd "$HOME/docker/$s" && docker compose config -q && docker compose up -d) >>"$LOG" 2>&1; then
    done_list="$done_list $s"; log "deployed $s"
  else ok=0; log "FAILED $s"; fi
done
ST=ok; [ $ok = 1 ] || ST=failed
log "$ST $SUBJ [$done_list ]"
if [ $ok = 1 ]; then "$HOME/bin/ntfy-send" "Deploy ok" "$SUBJ |$done_list" default white_check_mark
else "$HOME/bin/ntfy-send" "Deploy FAILED" "$SUBJ" high warning; fi
[ -n "$N8N_WEBHOOK" ] && curl -fsS -m 10 -H 'Content-Type: application/json' \
  -d "{\"commit\":\"$SUBJ\",\"status\":\"$ST\",\"stacks\":\"$done_list\"}" "$N8N_WEBHOOK" >/dev/null 2>&1
[ -n "$HERMES_CMD" ] && git diff "$OLD" "$NEW" | $HERMES_CMD >>"$LOG" 2>&1
exit 0
